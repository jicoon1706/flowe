<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!--
    Android 11+ hides other installed apps unless they're declared here. Flowe
    only needs to know which of the supported bank/e-wallet apps exist, so the
    Auto-detect screen can grey out the ones that aren't installed. Keep in sync
    with NOTIFICATION_SOURCES in constants/notificationSources.ts.
  -->
  <queries>
    <package android:name="com.maybank2u.life" />
    <package android:name="com.maybank2u.m2umobile" />
    <package android:name="com.cimb.cimbclicks" />
    <package android:name="com.cimb.octo" />
    <package android:name="com.pbb.pbengine" />
    <package android:name="com.rhbgroup.mobilebanking" />
    <package android:name="com.hlb.connect" />
    <package android:name="com.ambank.amonline" />
    <package android:name="com.bankislam.bimb" />
    <package android:name="my.com.bsn.mybsn" />
    <package android:name="com.setel.mobile" />
    <package android:name="my.com.tngdigital.ewallet" />
    <package android:name="com.grabtaxi.passenger" />
    <package android:name="com.boost.consumer" />
    <package android:name="com.shopee.my" />
  </queries>

  <application>
    <!--
      Reading other apps' notifications requires the user to grant Flowe
      "Notification access" in system settings; the BIND_NOTIFICATION_LISTENER_SERVICE
      permission below is what makes Flowe appear in that list. Android never
      grants it silently.
    -->
    <service
      android:name="expo.modules.flowenotifications.TransactionNotificationListenerService"
      android:label="Flowe transaction detection"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <receiver
      android:name="expo.modules.flowenotifications.QuickCaptureReceiver"
      android:exported="false" />
  </application>
</manifest>
