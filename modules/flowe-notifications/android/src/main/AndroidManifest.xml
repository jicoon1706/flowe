<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!--
    Android 16 Live Updates: lets the daily-budget notification be promoted
    (pinned above the shade, chip in the status bar). A normal permission —
    granted at install, and the user can switch it off per app in Settings.
    Older versions ignore it.
  -->
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

  <!--
    The headless task that files a detected payment with the app closed: a
    wake lock so the phone stays up for the second it takes, and a foreground
    service as the fallback when Android refuses a plain background start.
  -->
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

  <!--
    Android 11+ hides other installed apps unless they're declared here. Flowe
    only needs to know which of the supported bank/e-wallet apps exist, so the
    Auto-detect screen can grey out the ones that aren't installed. Keep in sync
    with NOTIFICATION_SOURCES in constants/notificationSources.ts.
  -->
  <queries>
    <package android:name="com.maybank2u.life" />
    <package android:name="com.maybank2u.m2umobile" />
    <package android:name="com.cimb.cimbclicks" />
    <package android:name="com.cimb.octo" />
    <package android:name="com.pbb.pbengine" />
    <package android:name="com.rhbgroup.mobilebanking" />
    <package android:name="com.hlb.connect" />
    <package android:name="com.ambank.amonline" />
    <package android:name="com.bankislam.bimb" />
    <package android:name="my.com.bsn.mybsn" />
    <package android:name="com.setel.mobile" />
    <package android:name="my.com.tngdigital.ewallet" />
    <package android:name="com.grabtaxi.passenger" />
    <package android:name="com.boost.consumer" />
    <package android:name="com.shopee.my" />
  </queries>

  <application>
    <!--
      Reading other apps' notifications requires the user to grant Flowe
      "Notification access" in system settings; the BIND_NOTIFICATION_LISTENER_SERVICE
      permission below is what makes Flowe appear in that list. Android never
      grants it silently.
    -->
    <service
      android:name="expo.modules.flowenotifications.TransactionNotificationListenerService"
      android:label="Flowe transaction detection"
      android:exported="false"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Runs the FloweAutoFile JS task headlessly; see AutoFileTaskService.kt. -->
    <service
      android:name="expo.modules.flowenotifications.AutoFileTaskService"
      android:exported="false"
      android:foregroundServiceType="shortService" />

    <receiver
      android:name="expo.modules.flowenotifications.QuickCaptureReceiver"
      android:exported="false" />
  </application>
</manifest>
