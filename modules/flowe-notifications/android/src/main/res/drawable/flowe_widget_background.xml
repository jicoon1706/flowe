<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's surface: Flowe's card colour and radius (bg-card #1A1A1A,
  rounded-2xl) with the same hairline border the app uses, so a widget sitting
  among the user's icons still reads as part of the app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="#1A1A1A" />
  <corners android:radius="16dp" />
  <stroke android:width="1dp" android:color="#1AFFFFFF" />
</shape>
